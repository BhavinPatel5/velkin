{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": false,
    "sourceMap": true,
    "paths": {
      "@velkin/ui": ["../ui/dist/index"],
      "@velkin/ui/*": ["../ui/dist/*"]
    }
