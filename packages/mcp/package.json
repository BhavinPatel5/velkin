{
  "name": "@velkin/mcp",
  "version": "0.1.0",
  "description": "MCP server for Velkin — component catalog, API docs, framework snippets, and theme guidance for AI coding assistants.",
  "type": "module",
  "bin": {
    "velkin-mcp": "dist/mcp-stdio-entry.js"
  },
  "exports": {
    ".": "./dist/server.js",
    "./http": "./dist/mcp-http-handler.js",
    "./docs": "./dist/docs.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "dist",
    "data",
    "docs",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/verify-mcp-tool-parity.mjs",
    "start": "node ./dist/mcp-stdio-entry.js",
    "start:http": "node ./dist/mcp-http-entry.js",
    "dev": "tsx ./src/mcp-stdio-entry.ts",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/mcp-stdio-entry.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@velkin/ui": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@velkin/ui-pro": {
      "optional": true
    },
    "@velkin/react": {
      "optional": true
    },
    "@velkin/vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@velkin/ui": "file:../ui",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BhavinPatel5/velkin.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://velkinui.com"
}
