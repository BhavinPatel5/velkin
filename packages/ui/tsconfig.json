{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "jsx": "preserve",
    "declaration": false,
    "sourceMap": true,
    "emitDecoratorMetadata": false,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts"]
}
